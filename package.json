{
  "name": "wro2026-field-tool",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "tsc && vite build --mode electron",
    "preview": "vite preview",
    "electron:start": "npm run build:electron && electron .",
    "electron:build": "npm run build:electron && electron-packager . WRO2026_MeasureTool --platform=win32 --arch=x64 --out=dist_electron --overwrite --icon=public/icon.ico"
  },
  "dependencies": {
    "konva": "^9.3.6",
    "lucide-react": "^0.378.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-konva": "^18.2.10",
    "use-image": "^1.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^30.0.1",
    "electron-packager": "^17.1.2",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
